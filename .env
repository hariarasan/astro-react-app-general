# Base URL for the astro-fast-api backend.
#
# Set to the deployed Render backend, so the app works without your Mac
# and local server running. To test against your local FastAPI server
# instead, comment this out and use the local URL below (also update
# client.ts's fallback default if you want that to be the long-term
# default instead).
API_BASE_URL=https://astro-fast-api.onrender.com

# Local testing alternative (uncomment to use instead of the line above):
# http://10.0.2.2:8000 is the special alias the Android emulator uses to
# reach the host machine's "localhost".
# - Physical device: use your computer's LAN IP instead, e.g.
#   http://192.168.1.23:8000 (same Wi-Fi network as the phone).
# - iOS simulator: http://localhost:8000 works directly.
# API_BASE_URL=http://10.0.2.2:8000

# This value is baked in at native build time - change it and rebuild
# (npx react-native run-android) for it to take effect.
