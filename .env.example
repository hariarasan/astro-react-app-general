# Copy this file to .env and adjust as needed, then rebuild the app
# (env values are baked in at native build time).
#
# http://10.0.2.2:8000 = Android emulator -> host machine's localhost
# http://localhost:8000 = iOS simulator (same machine)
# http://<your-lan-ip>:8000 = physical device on the same Wi-Fi network
API_BASE_URL=http://10.0.2.2:8000
